<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CityCare Password Changed</title>
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f3f4f6;padding:30px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background-color:#ffffff;border-radius:12px;overflow:hidden;">

          <!-- Header -->
          <tr>
            <td align="center" style="background-color:#2563eb;padding:28px 20px;">
              <h1 style="margin:0;color:#ffffff;font-size:28px;">CityCare</h1>
              <p style="margin:8px 0 0;color:#dbeafe;font-size:14px;">
                City Complaint &amp; Service Request Platform
              </p>
            </td>
          </tr>

          <!-- Success message -->
          <tr>
            <td style="padding:32px 28px;">
              <div style="text-align:center;margin-bottom:22px;">
                <div style="display:inline-block;width:64px;height:64px;line-height:64px;border-radius:50%;background-color:#dcfce7;color:#15803d;font-size:34px;font-weight:bold;">
                  &#10003;
                </div>
              </div>

              <h2 style="margin:0 0 18px;text-align:center;font-size:23px;color:#111827;">
                Password Changed Successfully
              </h2>

              <p style="margin:0 0 16px;font-size:15px;line-height:1.8;">
                Hello <strong><%= user.name %></strong>,
              </p>

              <p style="margin:0 0 20px;font-size:15px;line-height:1.8;color:#4b5563;">
                Your CityCare account password has been changed successfully.
                You can now sign in using your new password.
              </p>

              <!-- Change details -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;">
                <tr>
                  <td style="padding:16px 18px;">
                    <p style="margin:0 0 8px;font-size:13px;color:#6b7280;">
                      Password change date
                    </p>
                    <p style="margin:0;font-size:15px;font-weight:bold;color:#111827;">
                      <%= change_date %>
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Login button -->
              <table role="presentation" cellspacing="0" cellpadding="0" style="margin:26px auto;">
                <tr>
                  <td align="center" style="background-color:#2563eb;border-radius:7px;">
                    <a href="<%= login_url %>" style="display:inline-block;padding:14px 30px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:bold;">
                      Sign In to CityCare
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Security notice -->
              <div style="padding:16px;background-color:#fff7ed;border-left:4px solid #f97316;border-radius:4px;margin-bottom:20px;">
                <p style="margin:0 0 8px;font-size:14px;font-weight:bold;color:#9a3412;">
                  Didn't change your password?
                </p>
                <p style="margin:0;font-size:13px;line-height:1.7;color:#7c2d12;">
                  If you did not make this change, secure your account immediately
                  and contact our support team.
                </p>
              </div>

              <p style="margin:0;font-size:14px;line-height:1.8;color:#4b5563;">
                Need assistance?
                <a href="<%= support_url %>" style="color:#2563eb;text-decoration:none;font-weight:bold;">
                  Contact CityCare Support
                </a>.
              </p>

              <p style="margin:22px 0 0;font-size:14px;line-height:1.7;color:#4b5563;">
                Thank you for using CityCare.
              </p>
              <p style="margin:6px 0 0;font-size:14px;color:#111827;font-weight:bold;">
                The CityCare Team
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background-color:#f9fafb;padding:20px;border-top:1px solid #e5e7eb;">
              <p style="margin:0 0 8px;font-size:13px;color:#6b7280;">
                &copy; <%= new Date().getFullYear() %> CityCare. All rights reserved.
              </p>
              <p style="margin:0;font-size:12px;color:#9ca3af;">
                City Complaint &amp; Service Request Platform
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>